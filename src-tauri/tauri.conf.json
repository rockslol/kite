{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite",
  "version": "0.2.0",
  "identifier": "app.kite.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kite",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost kite: http://kite.localhost; media-src 'self' kite: http://kite.localhost; img-src 'self' data: https: kite: http://kite.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Music",
    "shortDescription": "A lightweight music player for YouTube, SoundCloud and local files",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NDM5NDdBNjc2NDA0MDAKUldRQUJHUm5lcFJENXBFY1d5N2lLL043SUxQU0hwdnZiSGdocXFKU213YzZPOGYzd29NbTVpUGUK",
      "endpoints": [
        "https://github.com/rockslol/kite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
